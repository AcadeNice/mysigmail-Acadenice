# По умолчанию все текстовые файлы храним с LF
* text=auto eol=lf

# Скрипты Windows оставляем CRLF (если есть)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix-скрипты явно LF
*.sh text eol=lf

# Маркдаун/конфиги — LF
*.md  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.tsconfig text eol=lf

# Бинарники не трогаем
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.pdf -text
*.woff -text
*.woff2 -text
